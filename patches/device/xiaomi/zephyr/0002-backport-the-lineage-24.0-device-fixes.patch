--- a/sepolicy/vendor/hal_usb_qti_zephyr.te
+++ b/sepolicy/vendor/hal_usb_qti_zephyr.te
@@ -4,5 +4,10 @@
 #
 
 # The USB QTI HAL probes the display backlight node while enumerating USB
-# configurations. It only needs to traverse the graphics sysfs directory.
+# configurations and reads the current brightness. It also looks for a `usb`
+# child under the battery supply; this kernel does not create that child, so
+# without search permission the lookup is audited every few seconds before
+# returning ENOENT.
 allow vendor_hal_usb_qti vendor_sysfs_graphics:dir search;
+allow vendor_hal_usb_qti vendor_sysfs_graphics:file { getattr open read };
+allow vendor_hal_usb_qti sysfs_batteryinfo:dir search;
diff --git a/sepolicy/vendor/mi_thermald.te b/sepolicy/vendor/mi_thermald.te
index 66bf4c6..24e0179 100644
--- a/sepolicy/vendor/mi_thermald.te
+++ b/sepolicy/vendor/mi_thermald.te
@@ -41,3 +41,31 @@ permissive mi_thermald;
 # Grant only traversal of the LED class here; the rest of the daemon's broad
 # access set stays permissive and is deliberately not reconstructed.
 allow mi_thermald sysfs_leds:dir search;
+
+# It also samples the charger current and both panel brightness nodes while
+# collecting thermal inputs. These were the remaining repeated denials in
+# dmesg (all permissive=1, so they only added audit noise):
+#
+#   avc: denied { search } for name="battery" ...
+#     tcontext=u:object_r:sysfs_batteryinfo:s0 tclass=dir
+#   avc: denied { read } for name="current_now" ...
+#     tcontext=u:object_r:sysfs_batteryinfo:s0 tclass=file
+#   avc: denied { search } for name="backlight" ...
+#     tcontext=u:object_r:vendor_sysfs_graphics:s0 tclass=dir
+#   avc: denied { read } for name="brightness" ...
+#     tcontext=u:object_r:vendor_sysfs_graphics:s0 tclass=file
+#   avc: denied { read } for name="brightness_clone" ...
+#     tcontext=u:object_r:sysfs_brightness_clone:s0 tclass=file
+#
+# Grant only those reads and the directory traversal they need. The daemon is
+# still permissive; this does not hand it write access to the panel.
+allow mi_thermald sysfs_batteryinfo:dir search;
+allow mi_thermald sysfs_batteryinfo:file { getattr open read };
+allow mi_thermald vendor_sysfs_graphics:dir search;
+allow mi_thermald vendor_sysfs_graphics:file { getattr open read };
+allow mi_thermald sysfs_brightness_clone:file { getattr open read };
+
+# It also enumerates /sys/class while selecting the nodes above. This is
+# read-only directory traversal; the domain remains permissive and no writes
+# are granted.
+allow mi_thermald sysfs:dir { getattr open read search };
diff --git a/sepolicy/vendor/property.te b/sepolicy/vendor/property.te
new file mode 100644
index 0000000..6982997
--- /dev/null
+++ b/sepolicy/vendor/property.te
@@ -0,0 +1,28 @@
+# Xiaomi fingerprint properties. Stock maps persist.vendor.sys.fp.* to
+# vendor_fp_prop; AOSP's default vendor_system_prop mapping makes vendor_init
+# refuse to load the FOD geometry from /vendor/build.prop:
+#
+#   avc: denied { set } for property=persist.vendor.sys.fp.fod.location.X_Y
+#     scontext=u:r:vendor_init:s0 tcontext=u:object_r:vendor_system_prop:s0
+#     tclass=property_service
+type vendor_fp_prop, property_type;
+type vendor_fp_info_prop, property_type;
+
+allow vendor_init vendor_fp_prop:property_service set;
+allow vendor_init vendor_fp_info_prop:property_service set;
+
+get_prop(hal_fingerprint_default, vendor_fp_prop)
+get_prop(hal_fingerprint_default, vendor_fp_info_prop)
+
+# The Goodix HAL publishes persist.vendor.sys.fp.vendor and
+# persist.vendor.sys.fp.bigdata.type after it opens the lower HAL. Those names
+# were remapped from vendor_system_prop to the fingerprint-specific types, so
+# the HAL needs set access in addition to the read access above.
+set_prop(hal_fingerprint_default, vendor_fp_prop)
+set_prop(hal_fingerprint_default, vendor_fp_info_prop)
+
+# The camera perf-optimisation script stores the pre-camera VM tunables in
+# vendor.camera.vm.* properties. vendor_default_prop may only be set by init
+# and vendor_init (neverallow in domain.te), so give these names their own
+# type and let the camera provider and QTI's init shell write them.
+type vendor_camera_vm_prop, property_type;
diff --git a/sepolicy/vendor/property_contexts b/sepolicy/vendor/property_contexts
new file mode 100644
index 0000000..6a7ab39
--- /dev/null
+++ b/sepolicy/vendor/property_contexts
@@ -0,0 +1,5 @@
+persist.vendor.sys.fp.        u:object_r:vendor_fp_prop:s0
+persist.vendor.sys.fp.info    u:object_r:vendor_fp_info_prop:s0
+persist.vendor.sys.fp.uid     u:object_r:vendor_fp_info_prop:s0
+
+vendor.camera.vm.             u:object_r:vendor_camera_vm_prop:s0
diff --git a/sepolicy/vendor/vendor_init_zephyr.te b/sepolicy/vendor/vendor_init_zephyr.te
new file mode 100644
index 0000000..3fda0f0
--- /dev/null
+++ b/sepolicy/vendor/vendor_init_zephyr.te
@@ -0,0 +1,30 @@
+#
+# SPDX-FileCopyrightText: The LineageOS Project
+# SPDX-License-Identifier: Apache-2.0
+#
+
+# /data/vendor/wlan_logs is created by init at post-fs-data, but QCOM's
+# file_contexts only labels /data/vendor/wifi/wlan_logs. Label the actual path
+# and let the post-fs-data restorecon move the existing directory and its logs
+# to vendor_wifi_vendor_log_data_file. Only vendor_init performs this relabel.
+allow vendor_init vendor_data_file:dir { getattr open read search relabelfrom };
+allow vendor_init vendor_data_file:file { getattr relabelfrom };
+allow vendor_init vendor_wifi_vendor_log_data_file:dir { getattr open read search relabelto };
+allow vendor_init vendor_wifi_vendor_log_data_file:file { getattr relabelto };
+
+# /mnt/vendor/persist is mounted with vendor_firmware_file as the default
+# context, so the Goodix calibration files arrive with that label even though
+# their file_contexts entry says vendor_fingerprint_data_file. The fingerprint
+# init script's restorecon_recursive was denied on relabelfrom, leaving the
+# files mislabeled and the TEE unable to read them. Allow vendor_init to
+# perform exactly that firmware -> fingerprint-data relabel.
+allow vendor_init vendor_firmware_file:file { getattr relabelfrom };
+allow vendor_init vendor_fingerprint_data_file:dir { getattr open read search };
+allow vendor_init vendor_fingerprint_data_file:file { getattr relabelto };
+
+# init.thn31.nfc.rc: `wait /dev/tms_nfc`, then chmod/chown, then `wait` and
+# chown /sys/nfc/chip_name. Without getattr the wait never sees the node and
+# the block stalls forever (494 denials in 13 minutes). setattr is the
+# chmod/chown.
+allow vendor_init nfc_device:chr_file { getattr setattr };
+allow vendor_init sysfs_zephyr_nfc_chip_name:file { getattr setattr };
diff --git a/sepolicy/vendor/vendor_qti_init_shell_zephyr.te b/sepolicy/vendor/vendor_qti_init_shell_zephyr.te
new file mode 100644
index 0000000..f30501d
--- /dev/null
+++ b/sepolicy/vendor/vendor_qti_init_shell_zephyr.te
@@ -0,0 +1,34 @@
+#
+# SPDX-FileCopyrightText: The LineageOS Project
+# SPDX-License-Identifier: Apache-2.0
+#
+
+# init.qti.chg_policy.sh (vendor_qti_init_shell) chowns the charger and fuel
+# gauge attributes so the charging daemons can read them without root. zephyr's
+# supplies are Xiaomi's lx_chg_manager and the two I2C chargers, labelled
+# sysfs_batteryinfo by genfs_contexts, but the QCOM sm6225 policy only grants
+# the shell read access. 118 setattr denials per boot:
+#
+#   avc: denied { setattr } for comm="chown" name="uevent"
+#     scontext=u:r:vendor_qti_init_shell:s0
+#     tcontext=u:object_r:sysfs_batteryinfo:s0 tclass=file
+allow vendor_qti_init_shell sysfs_batteryinfo:file { getattr setattr };
+
+# Other one-shot boot writes from the same QTI init scripts: memory sleep and
+# page-cluster policy, the QDSS sink selection, and the USB configfs switches.
+# Denied, they only log noise, but the memory knobs are part of QTI's power
+# tuning and cost nothing to restore.
+allow vendor_qti_init_shell sysfs_mem_sleep:file w_file_perms;
+allow vendor_qti_init_shell proc_page_cluster:file w_file_perms;
+allow vendor_qti_init_shell vendor_sysfs_qdss_dev:file w_file_perms;
+allow vendor_qti_init_shell configfs:dir w_dir_perms;
+
+# The camera perf-optimisation script (init.qti.cam.perfopt.sh) is executed
+# with this domain by the camera provider rc. QTI allows the shell to write the
+# watermark tunable but not to read it back before saving it, and grants no
+# access to drop_caches at all.
+allow vendor_qti_init_shell proc_watermark_scale_factor:file r_file_perms;
+allow vendor_qti_init_shell proc_drop_caches:file w_file_perms;
+
+# Its swappiness/watermark backups live in vendor.camera.vm.*; see property.te.
+set_prop(vendor_qti_init_shell, vendor_camera_vm_prop);
diff --git a/sepolicy/vendor/vendor_sensors.te b/sepolicy/vendor/vendor_sensors.te
index e66a0ba..13a75d9 100644
--- a/sepolicy/vendor/vendor_sensors.te
+++ b/sepolicy/vendor/vendor_sensors.te
@@ -11,3 +11,22 @@
 # nodes share proc_tp_proximity_data; see file.te for the denials that repeat
 # while the proximity sensor is armed.
 allow vendor_sensors proc_tp_proximity_data:file rw_file_perms;
+
+# The UDFPS sensors sub-HAL arms the touch controller's FOD mode through the
+# xiaomi_tp command node, then watches the driver's press flag to deliver the
+# one-shot doze trigger. The touch feature service normally owns this node;
+# the sub-HAL runs in the sensors multihal process, which is also uid system,
+# so it only needs the matching SELinux access and the generic sysfs walk.
+allow hal_sensors_default xiaomi_touch_device:chr_file rw_file_perms;
+allow hal_sensors_default sysfs:dir r_dir_perms;
+allow hal_sensors_default sysfs:file r_file_perms;
+
+# sscrpcd probes the NFC controller's chip_name while it builds its sensor
+# list; the node has its own type now (see file.te/genfs_contexts).
+allow vendor_sensors sysfs_zephyr_nfc_chip_name:file r_file_perms;
+
+# The sensors HAL enables the panel's palm sensor before arming the proximity
+# stream. /sys/class/sensors/palm_sensor carries the generic sysfs label; the
+# existing rule above is read-only, so the write was denied and palm rejection
+# never turned on.
+allow hal_sensors_default sysfs:file w_file_perms;
diff --git a/sepolicy/vendor/wcnss_service_zephyr.te b/sepolicy/vendor/wcnss_service_zephyr.te
new file mode 100644
index 0000000..3fe9cb7
--- /dev/null
+++ b/sepolicy/vendor/wcnss_service_zephyr.te
@@ -0,0 +1,20 @@
+#
+# SPDX-FileCopyrightText: The LineageOS Project
+# SPDX-License-Identifier: Apache-2.0
+#
+
+# cnss_diag writes and rotates firmware logs in /data/vendor/wlan_logs. The QCOM
+# wcnss policy already grants create_dir_perms/create_file_perms on
+# vendor_wifi_vendor_log_data_file in userdebug builds, but it does not grant
+# the read/write directory permissions needed once the directory exists. The
+# path label is supplied by file_contexts and applied by init.target.rc.
+allow vendor_wcnss_service vendor_wifi_vendor_log_data_file:dir rw_dir_perms;
+
+# cnss-daemon publishes a couple of WLAN properties at boot. The property
+# service itself is reached over property_socket, and the daemon was missing
+# the socket write, so every setprop failed before the property check:
+#
+#   avc: denied { write } for comm="cnss-daemon" name="property_service"
+#     scontext=u:r:vendor_wcnss_service:s0
+#     tcontext=u:object_r:property_socket:s0 tclass=sock_file
+allow vendor_wcnss_service property_socket:sock_file write;
