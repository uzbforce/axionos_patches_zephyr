+#
+# SPDX-FileCopyrightText: The LineageOS Project
+# SPDX-License-Identifier: Apache-2.0
+#
+
+# The camera provider reads battery temp/capacity while it builds its thermal
+# metadata, and the QTI perf HAL reads battery status every ten seconds for its
+# power hints. Both only traverse the directory today (hal_camera_default.te
+# and hal_perf_default_zephyr.te grant search), so the actual reads are denied
+# and the hints fall back to safe defaults:
+#
+#   avc: denied { read } for comm="camera.provider" name="temp"
+#     scontext=u:r:hal_camera_default:s0
+#     tcontext=u:object_r:sysfs_batteryinfo:s0 tclass=file
+#   avc: denied { read } for comm="lmCoreThread" name="status"
+#     scontext=u:r:vendor_hal_perf_default:s0
+#     tcontext=u:object_r:sysfs_batteryinfo:s0 tclass=file
+allow hal_camera_default sysfs_batteryinfo:file r_file_perms;
+allow vendor_hal_perf_default sysfs_batteryinfo:file r_file_perms;
